	<rdfs:comment>SCF did not converge OR retrieved folder lacks out.xml (pitfall 39: check for SSH-drop DONE-marking).</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>Other FLEUR workchain exits: 300/301 fleur.base general, 360 elastic stage.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_362">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>ERROR_DID_NOT_CONVERGE: SCF ran full iterations without converging. Physics, not infra.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_412">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>fleur.mpds top-level: SCF converged but downstream property calc not triggered.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_497">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>CDGFleurSCFOptimizer: SCF converged but lattice optimization incomplete.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_5xx">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>Infra failures, empty reason string in the dft.mpds.io listing.</rdfs:comment>
</rdf:Description>
