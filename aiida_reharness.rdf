<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
	xmlns="https://mpds.io/ontology#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:xml="http://www.w3.org/XML/1998/namespace"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
<owl:Ontology rdf:about="https://mpds.io/ontology.rdf">
	<rdfs:comment>aiida-reharness extension for the MPDS materials ontology: computation, campaign-plan and experience layers. Additive-only over the base; generated by gen_aiida_reharness.py.</rdfs:comment>
	<owl:imports rdf:resource="http://www.semanticweb.org/ivan/ontologies/2024/0/ontomat"/>
</owl:Ontology>
<!-- ================= LAYER 1: COMPUTATION TBox ===================== -->
<owl:Class rdf:about="https://mpds.io/ontology#ComputationalArtefact">
	<rdfs:comment>Root of the aiida-reharness computation layer. Additive over the base materials ontology.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#DFTSystem">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>A concrete material system submitted to an ab-initio campaign. The unit of serial one-system-at-a-time campaigns.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#CalculationTask">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>One engine run (SCF, geometry optimization, phonons). Maps to an AiiDA CalcJob or a direct yascheduler task.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#Engine">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>An ab-initio code.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#FLEUR">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#Engine"/>
	<rdfs:comment>FLEUR MaX 6.2. Only Anderson and straight mixing are implemented in this build.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#CRYSTAL">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#Engine"/>
	<rdfs:comment>CRYSTAL23 public (Pcrystal MPI binary).</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#Inpgen">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#Engine"/>
	<rdfs:comment>FLEUR input generator.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#LLMEngine">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#Engine"/>
	<rdfs:comment>A self-hosted LLM used as a zero-external-cost reasoning assistant for ontology tasks (axiom help, unmatched-failure diagnosis). Not a DFT engine.</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#fleur">
	<rdf:type rdf:resource="https://mpds.io/ontology#FLEUR"/>
	<rdfs:comment>The [engine.fleur] yascheduler engine: FLEUR MaX 6.2, platforms linux darwin.</rdfs:comment>
	<hasYaschedulerKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fleur</hasYaschedulerKey>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#pcrystal">
	<rdf:type rdf:resource="https://mpds.io/ontology#CRYSTAL"/>
	<rdfs:comment>The [engine.pcrystal] yascheduler engine: Pcrystal MPI binary, CRYSTAL23.</rdfs:comment>
	<hasYaschedulerKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pcrystal</hasYaschedulerKey>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#inpgen">
	<rdf:type rdf:resource="https://mpds.io/ontology#Inpgen"/>
	<rdfs:comment>inpgen input generator (lattice -&gt; inp.xml).</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#qwen">
	<rdf:type rdf:resource="https://mpds.io/ontology#LLMEngine"/>
	<rdfs:comment>The Mac's self-hosted LM Studio LLM (afghani-578.local, OpenAI-compatible API). Assistance with ontology: axiom authoring help, diagnosis of failures that match no experience signature. Zero external API cost.</rdfs:comment>
	<hasModelId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qwen/qwen3.8-27b</hasModelId>
	<hasEndpoint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://afghani-578.local:1234/v1</hasEndpoint>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#fleur">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#pcrystal"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#fleur">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#inpgen"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#fleur">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#qwen"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#pcrystal">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#inpgen"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#pcrystal">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#qwen"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#inpgen">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#qwen"/>
</rdf:Description>
<owl:DatatypeProperty rdf:about="https://mpds.io/ontology#hasYaschedulerKey">
	<rdfs:domain rdf:resource="https://mpds.io/ontology#Engine"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<rdfs:comment>The yascheduler engine config section key ([engine.&lt;key&gt;]).</rdfs:comment>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="https://mpds.io/ontology#hasModelId">
	<rdfs:domain rdf:resource="https://mpds.io/ontology#LLMEngine"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<rdfs:comment>Model id at the OpenAI-compatible endpoint.</rdfs:comment>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="https://mpds.io/ontology#hasEndpoint">
	<rdfs:domain rdf:resource="https://mpds.io/ontology#LLMEngine"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<rdfs:comment>Base URL of the OpenAI-compatible endpoint.</rdfs:comment>
</owl:DatatypeProperty>
<owl:Class rdf:about="https://mpds.io/ontology#ComputeNode">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>A machine registered in yascheduler_nodes.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#HomeServerNode">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputeNode"/>
	<rdfs:comment>Ubuntu home server, 16 physical cores, local yascheduler node.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#VultrBareMetalNode">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputeNode"/>
	<rdfs:comment>vbm-24c-256gb-amd EPYC bare-metal (policy: max 1BM+1VM).</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#MacNode">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputeNode"/>
	<rdfs:comment>Afghani-578.local arm64. Wi-Fi only, sleeps without caffeinate, DHCP address.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#HetznerNode">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputeNode"/>
	<rdfs:comment>VPS with intermittent SSH drops: premature DONE, truncated out.xml.</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#home_server">
	<rdf:type rdf:resource="https://mpds.io/ontology#HomeServerNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#vultr_bm">
	<rdf:type rdf:resource="https://mpds.io/ontology#VultrBareMetalNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#mac_node">
	<rdf:type rdf:resource="https://mpds.io/ontology#MacNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#HomeServerNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#VultrBareMetalNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#HomeServerNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#MacNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#HomeServerNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#HetznerNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#VultrBareMetalNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#MacNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#VultrBareMetalNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#HetznerNode"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#MacNode">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#HetznerNode"/>
</rdf:Description>
<owl:Class rdf:about="https://mpds.io/ontology#Platform">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>OS platform of a compute node.</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#linux">
	<rdf:type rdf:resource="https://mpds.io/ontology#Platform"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#darwin">
	<rdf:type rdf:resource="https://mpds.io/ontology#Platform"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#linux">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#darwin"/>
</rdf:Description>
<owl:Class rdf:about="https://mpds.io/ontology#SubmitChannel">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>How a task reaches the engine: AiiDA workchain (provenance-tracked) or direct yascheduler API.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#AiiDAWorkChain">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#SubmitChannel"/>
	<rdfs:comment>fleur.mpds / crystal.mpds / CDGFleurSCFOptimizer via the yascheduler computer. Provenance, caching, restart.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#DirectYaschedulerAPI">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#SubmitChannel"/>
	<rdfs:comment>queue_submit_task bypassing AiiDA. No provenance; used for resubmits and tests.</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#AiiDAWorkChain">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#DirectYaschedulerAPI"/>
</rdf:Description>
<owl:Class rdf:about="https://mpds.io/ontology#FsmLayer">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>The aiida-reharness time-scale split: which layer owns a decision.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#OrchestrationLayer">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#FsmLayer"/>
	<rdfs:comment>reharness FSM: code/agent leaves, wait states, guards, approval gates. Event-scale.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#ComputeLayer">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#FsmLayer"/>
	<rdfs:comment>AiiDA daemon: CalcJobs/WorkChains. Days-scale, provenance-tracked.</rdfs:comment>
</owl:Class>
<owl:Class rdf:about="https://mpds.io/ontology#ReasoningLayer">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#FsmLayer"/>
	<rdfs:comment>pyfactxx ontology classification: plan validation at compile time, diagnosis at runtime. Zero tokens.</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#OrchestrationLayer">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#ComputeLayer"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#OrchestrationLayer">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#ReasoningLayer"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#ComputeLayer">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#ReasoningLayer"/>
</rdf:Description>
<owl:Class rdf:about="https://mpds.io/ontology#AiiDAExitCodeFamily">
	<rdfs:subClassOf rdf:resource="https://mpds.io/ontology#ComputationalArtefact"/>
	<rdfs:comment>Exit-code family of a finished process (dft.mpds.io listing convention).</rdfs:comment>
</owl:Class>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>Success.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>SCF did not converge OR retrieved folder lacks out.xml (pitfall 39: check for SSH-drop DONE-marking).</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>Other FLEUR workchain exits: 300/301 fleur.base general, 360 elastic stage.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_362">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>ERROR_DID_NOT_CONVERGE: SCF ran full iterations without converging. Physics, not infra.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_412">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>fleur.mpds top-level: SCF converged but downstream property calc not triggered.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_497">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>CDGFleurSCFOptimizer: SCF converged but lattice optimization incomplete.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_5xx">
	<rdf:type rdf:resource="https://mpds.io/ontology#AiiDAExitCodeFamily"/>
	<rdfs:comment>Infra failures, empty reason string in the dft.mpds.io listing.</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_303"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_3xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_362"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_412"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_497"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_0">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_5xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_3xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_362"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_412"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_497"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_303">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_5xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_362"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_412"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_497"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_3xx">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_5xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_362">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_412"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_362">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_497"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_362">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_5xx"/>
</rdf:Description>
<rdf:Description rdf:about="https://mpds.io/ontology#exit_412">
	<owl:disjointWith rdf:resource="https://mpds.io/ontology#exit_497"/>
