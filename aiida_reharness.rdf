</rdf:Description>
<rdf:Description rdf:about="http://www.semanticweb.org/ivan/ontologies/2024/0/ontomat#Tm">
	<rdf:type rdf:resource="https://mpds.io/ontology#HeavyElement"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.semanticweb.org/ivan/ontologies/2024/0/ontomat#Yb">
	<rdf:type rdf:resource="https://mpds.io/ontology#HeavyElement"/>
</rdf:Description>
