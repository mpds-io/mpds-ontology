@prefix base: <http://www.semanticweb.org/ivan/ontologies/2024/0/ontomat#> .
@prefix ext: <https://mpds.io/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

base:LinusPaulingNumsNonEq a owl:ObjectProperty ;
    rdfs:domain base:CrystalStructure .

base:hasAtmosphere a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasBasisNonEq a owl:ObjectProperty ;
    rdfs:domain base:CrystalStructure .

base:hasComments a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:hasCondition a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:double .

base:hasCrucible a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasCrystalGrowth a owl:DatatypeProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasDescr a owl:DatatypeProperty ;
    rdfs:domain base:StartingMaterial ;
    rdfs:range xsd:string .

base:hasElsNonEq a owl:ObjectProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range base:ChemicalElement .

base:hasLabel a owl:DatatypeProperty ;
    rdfs:domain base:Shape ;
    rdfs:range xsd:string .

base:hasLabels a owl:ObjectProperty ;
    rdfs:domain base:PhaseDiagram .

base:hasLabelsNonEq a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:hasMeasurement a owl:ObjectProperty ;
    rdfs:domain base:Sample ;
    rdfs:range base:Measurement .

base:hasMineral a owl:DatatypeProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasNPhases a owl:DatatypeProperty ;
    rdfs:domain base:Shape ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 1 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 5 ] ;
                            rdf:rest () ] ] ] .

base:hasObjectRepr a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:CrystalStructure ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Material ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:PhaseDiagram ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:range xsd:string .

base:hasOccsNonEq a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 1e-04 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 1e+00 ] ;
                            rdf:rest () ] ] ] .

base:hasPeriodicNumsNonEq a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 1 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 236 ] ;
                            rdf:rest () ] ] ] .

base:hasPhase a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:CrystalStructure ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Material ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:Reference ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first base:Shape ;
                                            rdf:rest () ] ] ] ] ] ;
    rdfs:range xsd:string .

base:hasPhaseId a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:CrystalStructure ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Material ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:Shape ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:range xsd:double .

base:hasPurity a owl:DatatypeProperty ;
    rdfs:domain base:StartingMaterial ;
    rdfs:range xsd:string .

base:hasRFactor a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 1e-03 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 1e+00 ] ;
                            rdf:rest () ] ] ] .

base:hasRefLabel a owl:DatatypeProperty ;
    rdfs:domain base:Shape ;
    rdfs:range xsd:integer .

base:hasSSymNonEq a owl:ObjectProperty ;
    rdfs:domain base:CrystalStructure .

base:hasScalar a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Property ;
    rdfs:range xsd:double .

base:hasScalars a owl:DatatypeProperty ;
    rdfs:domain base:Condition ;
    rdfs:range xsd:double .

base:hasSolvent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasStartingMaterial a owl:ObjectProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range base:StartingMaterial .

base:hasSynthesis a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Preparation ;
    rdfs:range xsd:string .

base:hasText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Condition ;
    rdfs:range xsd:string .

base:hasWyckNonEq a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:isSolid a owl:DatatypeProperty ;
    rdfs:domain base:Shape ;
    rdfs:range xsd:boolean .

ext:AiiDAWorkChain a owl:Class ;
    rdfs:comment "fleur.mpds / crystal.mpds / CDGFleurSCFOptimizer via the yascheduler computer. Provenance, caching, restart." ;
    rdfs:subClassOf ext:SubmitChannel ;
    owl:disjointWith ext:DirectYaschedulerAPI .

ext:AllTasksExit412 a owl:Class ;
    rdfs:comment "DEPRECATED indirection: FaCT++ realisation does not classify instances into forall-defined classes (verified empirically), so this class carries no equivalentClass axiom. The all-tasks-exit-412 check is a plan-bUILDER assertion (hasAllTasksExit412), asserted closed-world from the observed task states." ;
    rdfs:subClassOf ext:CampaignPlan .

ext:Anderson a ext:MixingScheme ;
    rdfs:comment "Default choice: alpha 0.15 converges NiZn in 17 iterations (pitfall 22b)." ;
    owl:disjointWith ext:Broyden1,
        ext:Broyden2,
        ext:Straight .

ext:Broyden2OnFLEUR62 a owl:Class ;
    rdfs:comment "Same trap with Broyden2 (pitfall 15)." ;
    rdfs:subClassOf ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:hasValue ext:Broyden2 ;
                        owl:onProperty ext:hasMixingScheme ] ) ] .

ext:OrchestrationLayer a owl:Class ;
    rdfs:comment "reharness FSM: code/agent leaves, wait states, guards, approval gates. Event-scale." ;
    rdfs:subClassOf ext:FsmLayer ;
    owl:disjointWith ext:ComputeLayer,
        ext:ReasoningLayer .

ext:PRDApprovedPlan a owl:Class ;
    rdfs:comment "A plan whose PRD the human approved. The only plan a run may start (reharness: the human approves the intent, never the graph)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:prdApproved ],
        ext:CampaignPlan .

ext:PropertyTargetedPlan a owl:Class ;
    rdfs:comment "A plan generated FROM a property-hierarchy entry (hasTargetProperty some base Property)." ;
    rdfs:subClassOf ext:CampaignPlan ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CampaignPlan [ a owl:Restriction ;
                        owl:onProperty ext:hasTargetProperty ;
                        owl:someValuesFrom base:Property ] ) ] .

ext:exit_0 a ext:AiiDAExitCodeFamily ;
    rdfs:comment "Success." ;
    owl:disjointWith ext:exit_303,
        ext:exit_362,
        ext:exit_3xx,
        ext:exit_412,
        ext:exit_497,
        ext:exit_5xx .

ext:hasDetectedClass a owl:ObjectProperty ;
    rdfs:comment "The plan-level detection class that flags this failure mode pre-emptively (range: the detection classes above)." ;
    rdfs:domain ext:EngineFailureMode .

ext:hasEndpoint a owl:DatatypeProperty ;
    rdfs:comment "Base URL of the OpenAI-compatible endpoint." ;
    rdfs:domain ext:LLMEngine ;
    rdfs:range xsd:string .

ext:hasEvidenceCommand a owl:DatatypeProperty ;
    rdfs:comment "Deterministic evidence-gathering command to run before concluding the mode." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range xsd:string .

ext:hasExecutionMode a owl:ObjectProperty ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range ext:ExecutionMode .

ext:hasFailureMode a owl:ObjectProperty ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:EngineFailureMode .

ext:hasFix a owl:DatatypeProperty ;
    rdfs:comment "The known fix: exact command or action, from the collected experience." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range xsd:string .

ext:hasModelId a owl:DatatypeProperty ;
    rdfs:comment "Model id at the OpenAI-compatible endpoint." ;
    rdfs:domain ext:LLMEngine ;
    rdfs:range xsd:string .

ext:hasObservedExitCode a owl:ObjectProperty ;
    rdfs:comment "Exit-code family typically observed for this failure mode." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range ext:AiiDAExitCodeFamily .

ext:hasPitfallRef a owl:DatatypeProperty ;
    rdfs:comment "Pitfall identifier in the collected experience (mpds-aiida skill taxonomy), e.g. 8c, 22b, 42-BSD." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range xsd:string .

ext:hasRouting a owl:ObjectProperty ;
    rdfs:comment "Where the FSM routes a failure of this mode: code / agent / approval / wait." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range ext:FsmStateKind .

ext:hasSignature a owl:DatatypeProperty ;
    rdfs:comment "Deterministic signature regexes (Python re syntax) matched against failure text." ;
    rdfs:domain ext:EngineFailureMode ;
    rdfs:range xsd:string .

ext:hasSignatureText a owl:DatatypeProperty ;
    rdfs:comment "Raw failure text (engine error line, parser message, log line) asserted for diagnosis." ;
    rdfs:domain ext:Observation ;
    rdfs:range xsd:string .

ext:hasStep a owl:ObjectProperty ;
    rdfs:comment "Composition: a workflow runs these workchain steps." ;
    rdfs:domain ext:ComputationalWorkflow ;
    rdfs:range ext:WorkChainStep .

ext:hasYaschedulerKey a owl:DatatypeProperty ;
    rdfs:comment "The yascheduler engine config section key ([engine.<key>])." ;
    rdfs:domain ext:Engine ;
    rdfs:range xsd:string .

ext:home_server a ext:HomeServerNode .

ext:linux a ext:Platform ;
    owl:disjointWith ext:darwin .

ext:mac_node a ext:MacNode .

ext:pf_broyden_not_implemented a ext:InputPrepFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "The InputSchema lists Broyden1/2 as valid imix values but the build errors at startup." ;
    ext:hasDetectedClass ext:BroydenOnFLEUR62 ;
    ext:hasFix "Use Anderson mixing alpha=0.15 (or straight as last resort). Broyden1/Broyden2 are NOT implemented in the FLEUR 6.2 build."^^xsd:string ;
    ext:hasPitfallRef "15"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "Broyden 1/2 method not implemented"^^xsd:string .

ext:pf_false_idle_occupancy a ext:InfraFailureMode ;
    rdfs:comment "THE physics-vs-infra separation rule: verify evals ran before tuning SCF parameters." ;
    ext:hasDetectedClass ext:InfraSignatureBatch ;
    ext:hasEvidenceCommand "Verify evals actually ran: yac task rows for the eval calcjobs + iteration count in the retrieved out file, BEFORE tuning SCF parameters"^^xsd:string ;
    ext:hasFix "BSD ps vs GNU :255 occupancy poll bug: false-idle node polls rmtree live task dirs on Darwin; engines die silently RC=2. Fixed in installed yascheduler 1.8.1 (kit /data/fleur_campaign/patches/). A uniform fast-412 batch with eval exit 0 = infra, not physics."^^xsd:string ;
    ext:hasPitfallRef "42"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "uniform batch of fast 412s"^^xsd:string .

ext:pf_ghost_states a ext:ConvergenceFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "Ghost states from core electrons of f-elements abort the run. Warning escalated to fatal by default." ;
    ext:hasDetectedClass ext:NeedsJUDFTWarnOnly ;
    ext:hasFix "Stage JUDFT_WARN_ONLY in the task dir before the engine run. AiiDA FleurCalculation stages it automatically (line 465-468 of calculation.fleur); direct yascheduler API must have touch JUDFT_WARN_ONLY in the spawn command."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_303 ;
    ext:hasPitfallRef "8c"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "Too low eigenvalue detected"^^xsd:string .

ext:pf_mt_sphere_confinement a ext:BasisSetFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "High-n s valence states cannot confine in inpgen-auto large MT spheres of Ba/Cs/Rb/K. Dominant mode behind dft.mpds.io geometry-optimization failures." ;
    ext:hasDetectedClass ext:NeedsSphereCaps ;
    ext:hasFix "Per-system MT-sphere radius caps via set_species (masci_tools): use EXACT species names from that system inp.xml (e.g. \"Barium (Ba)\"); caps live in per-system templates only, never shared base templates. Diagnose the failing species from the FLEUR \"out\" file, not from expectation."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_303 ;
    ext:hasPitfallRef "37"^^xsd:string ;
    ext:hasRouting ext:agentState ;
    ext:hasSignature "differ 2: problems with solving dirac equation"^^xsd:string,
        "too few nodes"^^xsd:string .

ext:pf_orte_resource_exhaustion a ext:InfraFailureMode ;
    rdfs:comment "Batch-vs-serial scheduling decision grounded in a measured crash rate." ;
    ext:hasFix "Concurrent --oversubscribe Pcrystal tasks exhaust ORTE on small nodes: 17/37 crashed. Submit in batches of 5-10, match ncpus to physical cores, run campaigns serially."^^xsd:string ;
    ext:hasPitfallRef "20"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "ORTE_ERROR_LOG: Out of resource"^^xsd:string,
        "process killed \\(SIGTERM\\)"^^xsd:string .

ext:pf_premature_done a ext:InfraFailureMode ;
    rdfs:comment "DONE does not mean succeeded at either layer (pitfall 18/24)." ;
    ext:hasFix "Task marked DONE after 7-14 iterations on an SSH-unstable node. Cross-reference yascheduler_tasks.status=2 vs the AiiDA process state; resubmit; if persistent, disable the unstable node in yascheduler_nodes."^^xsd:string ;
    ext:hasPitfallRef "13"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "no </fleurOutput> closing tag"^^xsd:string .

ext:pf_spawn_channel_hangup a ext:InfraFailureMode ;
    rdfs:comment "Without nohup the engine dies after 1-3 SCF iterations; yascheduler still marks DONE." ;
    ext:hasDetectedClass ext:DirectFLEURSubmit ;
    ext:hasFix "nohup is REQUIRED in the yascheduler spawn command: run_bg creates the process on an SSH channel that is killed when the poll cycle reaps it. Never quote the live [engine.fleur] spawn from memory (pitfall 11): read it from /etc/yascheduler/yascheduler.conf."^^xsd:string ;
    ext:hasPitfallRef "31"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "completed after 1 iterations"^^xsd:string,
        "truncated mid-iteration"^^xsd:string .

ext:pf_stale_waiting_wedge a ext:InfraFailureMode ;
    rdfs:comment "Campaign driver precondition, checked pre-launch, not post-mortem." ;
    ext:hasFix "A stale waiting workchain of type fleur.mpds silently wedges the serial campaign driver: its submit gate counts active workchains. Clean waiting processes BEFORE launching a campaign (verdi process repair; kill remaining via ProcessNode set_exit_status(130) + seal; DROP the exit_status filter on sealed nodes)."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_412 ;
    ext:hasPitfallRef "33"^^xsd:string ;
    ext:hasRouting ext:codeState .

ext:pf_straight_too_conservative a ext:ConvergenceFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "PR #20 straight-mixing scheme evaluated and REFUTED on SrTiO3/GdNi/NiZn." ;
    ext:hasFix "Anderson alpha=0.15 (OLD scheme) converges NiZn in 17 iterations; straight alpha=0.05 stuck at 40-260 Htr. Straight-mixing 2x300 does NOT rescue 412/497 hard systems (attempt-2 reproduced attempt-1 exactly)."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_362 ;
    ext:hasPitfallRef "22b"^^xsd:string ;
    ext:hasRouting ext:agentState ;
    ext:hasSignature "DID_NOT_CONVERGE"^^xsd:string .

ext:pf_truncated_outxml a ext:InfraFailureMode ;
    rdfs:comment "Missing shell.out/out.error warnings are a RED HERRING: the parser only warns on those." ;
    ext:hasEvidenceCommand "sudo PGPASSWORD= /data/pg/bin/psql -h localhost -U postgres -d aiida -c \"...\" and yascheduler_tasks.metadata->>error for SSH failure records; compare retrieved FolderData content"^^xsd:string ;
    ext:hasFix "Root cause chain: SSH drop mid-write (pitfall 13/39) or spawn-channel hangup (pitfall 31) -> truncated out.xml -> masci_tools first parse consumes the handle at EOF (pitfall 33: wrap in seek(0)) -> exit 303. Resubmit; check yascheduler metadata for the SSH failure before tuning anything."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_303 ;
    ext:hasPitfallRef "12"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "Repairing was not possible"^^xsd:string,
        "The out.xml file is broken"^^xsd:string .

ext:pf_unit_cell_not_neutral a ext:BasisSetFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "A basis problem, not a runtime issue: the cell is fine, the assigned bases are not." ;
    ext:hasFix "Basis set charge mismatch (MPDSBSL_NEUTRAL_6TH family): Yb-containing perovskites with certain oxidation states. Custom basis assignments or different oxidation states needed per composition."^^xsd:string ;
    ext:hasPitfallRef "19"^^xsd:string ;
    ext:hasRouting ext:agentState ;
    ext:hasSignature "INPBAS \\*\\*\\*\\* UNIT CELL NOT NEUTRAL"^^xsd:string .

ext:pf_unverified_method_claim a ext:DiagnosticsGap ;
    rdfs:comment "Methodology gate: untested method claims route to human approval." ;
    ext:hasFix "Do NOT claim DFT+HIA/DFT+U is required for 4f systems without testing plain PBE first. GdNi: the actual issue was itmax 50 vs 200 and wrong alpha. 4f occupation fluctuation keeping distance at 1e-3..1e-4 is NORMAL; gate on held-out accuracy, not SatAgg (single-run sat is degenerate)."^^xsd:string ;
    ext:hasPitfallRef "9"^^xsd:string ;
    ext:hasRouting ext:approvalState .

ext:pf_walltime_keyerror a ext:InfraFailureMode ;
    rdfs:comment "Truncated out.xml yields partial output_parameters; bracket access Excepts the SCF workchain." ;
    ext:hasFix "Guard parser-derived keys: output_parameters.get(\"walltime\", 0) at scf.py line 696, and or 0 / .get(...) at every subtraction site in get_res. Patched in installed aiida_fleur (backup at .bak)."^^xsd:string ;
    ext:hasObservedExitCode ext:exit_497 ;
    ext:hasPitfallRef "35"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "KeyError: 'walltime'"^^xsd:string,
        "unsupported operand type\\(s\\) for -: 'NoneType' and 'NoneType'"^^xsd:string .

ext:pf_wbecke_neighbor_list a ext:BasisSetFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "Public-keyword limitations on the Mac arm64 build." ;
    ext:hasFix "LIMBEK is absent from the CRYSTAL23 public build (like CYCLES: use MAXCYCLE). For covalent solids: HF has no Becke grid, but diffuse bases (pob-DZVP-rev2, 6-21G*) may then hit BASIS SET LINEARLY DEPENDENT. MgO DFT-PBE works; Si diamond needs HF."^^xsd:string ;
    ext:hasPitfallRef "26"^^xsd:string ;
    ext:hasRouting ext:agentState ;
    ext:hasSignature "WBECKE_F NEIGHBOR LIST TOO BIG"^^xsd:string .

ext:pf_xinclude_not_flattened a ext:InputPrepFailureMode,
        ext:PhysicsFailureMode ;
    rdfs:comment "yascheduler only ships input_files: un-flattened XIncludes reference missing files." ;
    ext:hasFix "inpgen emits xi:include tags (NOT self-closing: href=\"kpts.xml\"> </xi:include>). Flatten all XIncludes into one self-contained inp.xml before submitting directly; assert len(re.findall(xi:include, inp_xml)) == 0. AiiDA FleurinpData flattens automatically."^^xsd:string ;
    ext:hasPitfallRef "1"^^xsd:string ;
    ext:hasRouting ext:codeState ;
    ext:hasSignature "XML document cannot be validated against Schema"^^xsd:string .

ext:prop_bulk_modulus a base:Property ;
    base:hasCategory "mechanical"^^xsd:string ;
    base:hasDomain "mechanics"^^xsd:string ;
    base:hasName "Bulk modulus"^^xsd:string ;
    base:hasUnits "GPa"^^xsd:string ;
    rdfs:comment "Isothermal bulk modulus from the equation-of-state fit of the volume scan." ;
    ext:realizedBy ext:wf_fleur_eos .

ext:prop_forces a base:Property ;
    base:hasCategory "mechanical"^^xsd:string ;
    base:hasDomain "mechanics"^^xsd:string ;
    base:hasName "Atomic forces and stress"^^xsd:string ;
    base:hasUnits "eV/angstrom (forces), GPa (stress)"^^xsd:string ;
    rdfs:comment "Single-point forces and stress tensor on the converged density of the relaxed geometry." ;
    ext:realizedBy ext:wf_fleur_forces .

ext:prop_magnetic_anisotropy a base:Property ;
    base:hasCategory "magnetic"^^xsd:string ;
    base:hasDomain "magnetism"^^xsd:string ;
    base:hasName "Magnetic anisotropy energy"^^xsd:string ;
    base:hasUnits "meV/formula unit"^^xsd:string ;
    rdfs:comment "Anisotropy energy from the magnetization-rotation scan; easy-axis orientation follows the minimum of the E(phi) curve." ;
    ext:realizedBy ext:wf_fleur_mae .

ext:prop_phonon_spectrum a base:Property ;
    base:hasCategory "vibrational"^^xsd:string ;
    base:hasDomain "vibrations"^^xsd:string ;
    base:hasName "Phonon spectrum"^^xsd:string ;
    base:hasUnits "THz"^^xsd:string ;
    rdfs:comment "Vibrational frequencies (phonon bands); imaginary modes route back to the geometry-optimization precondition (pitfalls 25, 27)." ;
    ext:realizedBy ext:wf_crystal_phonon,
        ext:wf_fleur_phonon .

ext:realizedBy a owl:ObjectProperty ;
    rdfs:comment "A base Property individual is realized by this workflow (asserted additively on base individuals)." ;
    rdfs:domain base:Property ;
    rdfs:range ext:ComputationalWorkflow .

ext:runsOn a owl:ObjectProperty ;
    rdfs:comment "yascheduler node the task deploys to." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:ComputeNode .

ext:serial a ext:ExecutionMode ;
    rdfs:comment "One system at a time, one engine owning all cores. House preference for DFT campaigns." ;
    owl:disjointWith ext:batch .

ext:vultr_bm a ext:VultrBareMetalNode .

ext:wf_crystal_seebeck a ext:SeebeckWorkflow ;
    rdfs:comment "CRYSTAL route: crystal.mpds SCF then crystal.mpds_seebeck." ;
    ext:hasStep ext:wc_crystal_scf,
        ext:wc_crystal_seebeck .

ext:wf_fleur_seebeck a ext:SeebeckWorkflow ;
    rdfs:comment "FLEUR route: fleur.mpds SCF then fleur.dos_seebeck." ;
    ext:hasStep ext:wc_fleur_dos,
        ext:wc_fleur_scf .

base:AbInitio a base:DataType,
        owl:NamedIndividual .

base:Binary a base:DiaType,
        owl:NamedIndividual .

base:Compound a owl:Class ;
    rdfs:subClassOf base:Shape .

base:Drawing a owl:Class ;
    rdfs:subClassOf base:Shape .

base:IsothermalSection a base:DiaType,
        owl:NamedIndividual .

base:LiquidusProjection a base:DiaType,
        owl:NamedIndividual .

base:MachineLearning a base:DataType,
        owl:NamedIndividual .

base:PeerReviewed a base:DataType,
        owl:NamedIndividual .

base:Phase a owl:Class ;
    rdfs:subClassOf base:Shape .

base:SolidusProjection a base:DiaType,
        owl:NamedIndividual .

base:SolvusProjection a base:DiaType,
        owl:NamedIndividual .

base:SubsolidusRelations a base:DiaType,
        owl:NamedIndividual .

base:VerticalSection a base:DiaType,
        owl:NamedIndividual .

base:hasArity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:PhaseDiagram ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 2 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 8 ] ;
                            rdf:rest () ] ] ] .

base:hasCategory a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Property ;
    rdfs:range xsd:string .

base:hasCellAbcs a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 5e-01 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 1.305e+03 ] ;
                            rdf:rest () ] ] ] .

base:hasCompA a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasCompB a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasCompC a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasCompEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:RectangularPlot .

base:hasCompRange a owl:ObjectProperty ;
    rdfs:domain base:RectangularPlot .

base:hasCompStart a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:RectangularPlot .

base:hasConditions a owl:ObjectProperty ;
    rdfs:domain base:Material ;
    rdfs:range base:Condition .

base:hasDataType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:Measurement ;
    rdfs:range base:DataType .

base:hasDensity a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 0e+00 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 5e+01 ] ;
                            rdf:rest () ] ] ] .

base:hasDiaType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:PhaseDiagram ;
    rdfs:range base:DiaType .

base:hasDomain a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Property ;
    rdfs:range xsd:string .

base:hasMaterial a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:Sample ;
    rdfs:range base:Material .

base:hasNaxes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:PhaseDiagram ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 2 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 3 ] ;
                            rdf:rest () ] ] ] .

base:hasProperty a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:Measurement ;
    rdfs:range base:Property .

base:hasPrototype a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:hasRangeA a owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasRangeB a owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasRangeC a owl:ObjectProperty ;
    rdfs:domain base:TriangularPlot .

base:hasSample a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain base:PhysicalProperty ;
    rdfs:range base:Sample .

base:hasSgHm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:hasSgN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 1 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 230 ] ;
                            rdf:rest () ] ] ] .

base:hasShapes a owl:ObjectProperty ;
    rdfs:domain base:PhaseDiagram ;
    rdfs:range base:Shape .

base:hasSvgPath a owl:DatatypeProperty ;
    rdfs:domain base:Shape ;
    rdfs:range xsd:string .

base:hasSymOps a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range xsd:string .

base:hasTemp a owl:DatatypeProperty ;
    rdfs:domain base:PhaseDiagram ;
    rdfs:range xsd:double .

base:hasTitleA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:TriangularPlot ;
    rdfs:range xsd:string .

base:hasTitleB a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:TriangularPlot ;
    rdfs:range xsd:string .

base:hasTitleC a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:TriangularPlot ;
    rdfs:range xsd:string .

base:hasUnits a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain base:Property ;
    rdfs:range xsd:string .

base:hasVolume a owl:DatatypeProperty ;
    rdfs:domain base:CrystalStructure ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:double ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive 0e+00 ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive 6e+05 ] ;
                            rdf:rest () ] ] ] .

ext:BroydenOnFLEUR62 a owl:Class ;
    rdfs:comment "Broyden1/2 mixing requested on the FLEUR 6.2 build: NOT implemented, the engine errors at startup (pitfall 15). Flagged by classification." ;
    rdfs:subClassOf ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:hasValue ext:Broyden1 ;
                        owl:onProperty ext:hasMixingScheme ] ) ] .

ext:CRYSTAL a owl:Class ;
    rdfs:comment "CRYSTAL23 public (Pcrystal MPI binary)." ;
    rdfs:subClassOf ext:Engine .

ext:ComputeLayer a owl:Class ;
    rdfs:comment "AiiDA daemon: CalcJobs/WorkChains. Days-scale, provenance-tracked." ;
    rdfs:subClassOf ext:FsmLayer ;
    owl:disjointWith ext:ReasoningLayer .

ext:DiagnosticsGap a owl:Class ;
    rdfs:comment "Failure modes with signature ambiguity: must cross-reference BOTH databases and read output files before routing (pitfall 24: DONE does not mean succeeded, at either layer)." ;
    rdfs:subClassOf ext:EngineFailureMode .

ext:DirectFLEURSubmit a owl:Class ;
    rdfs:comment "FLEUR task on the direct yascheduler API (no AiiDA staging): spawn must carry nohup and JUDFT_WARN_ONLY itself (pitfalls 31, 32). Gates: hasSpawnNohup AND hasMitigationJUDFTWarnOnly must both be true." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:hasMitigationJUDFTWarnOnly ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:hasSpawnNohup ],
        ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:hasValue ext:fleur ;
                        owl:onProperty ext:hasEngine ] [ a owl:Restriction ;
                        owl:hasValue ext:DirectYaschedulerAPI ;
                        owl:onProperty ext:hasSubmitChannel ] ) ] .

ext:EOSStage a owl:Class ;
    rdfs:comment "Equation-of-state stage: volume scan of the relaxed cell; the E(V) fit yields the bulk modulus." ;
    rdfs:subClassOf ext:WorkChainStep .

ext:EOSWorkflow a owl:Class ;
    rdfs:comment "Equation of state / bulk modulus: relaxed and converged SCF, then the volume scan." ;
    rdfs:subClassOf ext:ComputationalWorkflow .

ext:FElementSystem a owl:Class ;
    rdfs:comment "A system containing at least one f-element (lanthanide/actinide): JUDFT_WARN_ONLY required, 4f occupation fluctuation in SCF is normal (pitfalls 8c, 9)." ;
    rdfs:subClassOf ext:DFTSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:DFTSystem [ a owl:Restriction ;
                        owl:onProperty ext:hasElement ;
                        owl:someValuesFrom ext:HeavyElement ] ) ] .

ext:FLEUR a owl:Class ;
    rdfs:comment "FLEUR MaX 6.2. Only Anderson and straight mixing are implemented in this build." ;
    rdfs:subClassOf ext:Engine .

ext:ForceStage a owl:Class ;
    rdfs:comment "Force/stress stage: single-point forces and stress tensor on the converged density." ;
    rdfs:subClassOf ext:WorkChainStep .

ext:ForceWorkflow a owl:Class ;
    rdfs:comment "Atomic forces (and stress): converged SCF on the relaxed geometry, then the single-point force evaluation." ;
    rdfs:subClassOf ext:ComputationalWorkflow .

ext:HomeServerNode a owl:Class ;
    rdfs:comment "Ubuntu home server, 16 physical cores, local yascheduler node." ;
    rdfs:subClassOf ext:ComputeNode ;
    owl:disjointWith ext:HetznerNode,
        ext:MacNode,
        ext:VultrBareMetalNode .

ext:InfraSignatureBatch a owl:Class ;
    rdfs:comment "A fast uniform 412 batch with every evaluator CalcJob at exit 0: infrastructure failure signature (pitfall 42). Never tune SCF parameters in response. hasAllTasksExit412 is a closed-world builder assertion (FaCT++ cannot classify into forall-defined classes)." ;
    rdfs:subClassOf ext:CampaignPlan ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CampaignPlan [ a owl:Restriction ;
                        owl:onProperty ext:hasTask ;
                        owl:someValuesFrom ext:TaskExit412 ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty ext:hasAllTasksExit412 ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty ext:hasBatchEvalExitZero ] ) ] .

ext:Inpgen a owl:Class ;
    rdfs:comment "FLEUR input generator." ;
    rdfs:subClassOf ext:Engine .

ext:LargeSphereCationSystem a owl:Class ;
    rdfs:comment "A system containing Ba/Cs/Rb/K: inpgen auto-assigns large MT spheres, differ 2 at setup without per-system sphere caps (pitfall 37)." ;
    rdfs:subClassOf ext:DFTSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:DFTSystem [ a owl:Restriction ;
                        owl:onProperty ext:hasElement ;
                        owl:someValuesFrom ext:LargeMTSphereElement ] ) ] .

ext:MAEWorkflow a owl:Class ;
    rdfs:comment "Magnetic anisotropy energy: converged SCF, then the magnetization-rotation scan, then the MAE convergence gate." ;
    rdfs:subClassOf ext:ComputationalWorkflow .

ext:NeedsJUDFTWarnOnly a owl:Class ;
    rdfs:comment "Task over an f-element system: JUDFT_WARN_ONLY is REQUIRED (pitfall 8c). Gate: hasMitigationJUDFTWarnOnly must be true, else INCONSISTENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:hasMitigationJUDFTWarnOnly ],
        ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:onProperty ext:hasSystem ;
                        owl:someValuesFrom ext:FElementSystem ] ) ] .

ext:NeedsSphereCaps a owl:Class ;
    rdfs:comment "Task over a Ba/Cs/Rb/K system: per-system MT-sphere caps REQUIRED (pitfall 37). Gates: hasMitigationSphereCaps AND hasPerSystemTemplates must both be true." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:hasPerSystemTemplates ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty ext:hasMitigationSphereCaps ],
        ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:onProperty ext:hasSystem ;
                        owl:someValuesFrom ext:LargeSphereCationSystem ] ) ] .

ext:Observation a owl:Class ;
    rdfs:comment "A runtime observation asserted for diagnosis: exit code, output signature, elements seen." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:PhononStage a owl:Class ;
    rdfs:comment "Phonon stage: finite-displacement frequency calculation; requires the fully relaxed geometry, imaginary modes route back to geometry optimization (pitfalls 25, 27)." ;
    rdfs:subClassOf ext:WorkChainStep .

ext:Straight a ext:MixingScheme ;
    rdfs:comment "Too conservative for hard systems: stuck at 40-260 Htr distances (pitfalls 22b, 42)." ;
    owl:disjointWith ext:Broyden1,
        ext:Broyden2 .

ext:TaskExit412 a owl:Class ;
    rdfs:comment "A task whose observed exit-code family is 412." ;
    rdfs:subClassOf ext:CalculationTask ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ext:CalculationTask [ a owl:Restriction ;
                        owl:hasValue ext:exit_412 ;
                        owl:onProperty ext:hasExitCodeFamily ] ) ] .

ext:batch a ext:ExecutionMode ;
    rdfs:comment "Concurrent submissions. OpenMPI resource exhaustion risk on small nodes (pitfall 20)." .

ext:darwin a ext:Platform .

ext:fleur a ext:FLEUR ;
    rdfs:comment "The [engine.fleur] yascheduler engine: FLEUR MaX 6.2, platforms linux darwin." ;
    owl:disjointWith ext:inpgen,
        ext:pcrystal,
        ext:qwen ;
    ext:hasYaschedulerKey "fleur"^^xsd:string .

ext:hasAllTasksExit412 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Closed-world plan-builder assertion: every task in the plan observed at exit family 412. Computed by the validator from task states, not inferred by the reasoner (FaCT++ cannot classify into forall-defined classes)." ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range xsd:boolean .

ext:hasBatchEvalExitZero a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "True when every evaluator CalcJob in the observed batch finished exit 0 (pitfall 42-BSD: uniform fast 412s with clean evals = infra signature, not physics)." ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range xsd:boolean .

ext:hasEngine a owl:ObjectProperty ;
    rdfs:comment "Engine that runs the task." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:Engine .

ext:hasExitCodeFamily a owl:ObjectProperty ;
    rdfs:comment "Derived exit-code family." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:AiiDAExitCodeFamily .

ext:hasMitigationSphereCaps a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Per-system MT-sphere radius caps applied via set_species (pitfall 37: inpgen auto-assigns large spheres to heavy 6s cations; differ 2 aborts at setup)." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range xsd:boolean .

ext:hasPerSystemTemplates a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Species-level edits live in per-system templates, never in shared base templates (pitfall 38)." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range xsd:boolean .

ext:hasSpawnNohup a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "nohup present in the yascheduler spawn command (pitfall 31: run_bg kills the engine when the SSH poll cycle reaps the channel; symptom: 1-3 iterations then truncated out.xml)." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range xsd:boolean .

ext:hasSubmitChannel a owl:ObjectProperty ;
    rdfs:comment "AiiDA workchain vs direct API (pitfalls 17/18)." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:SubmitChannel .

ext:hasTargetProperty a owl:ObjectProperty ;
    rdfs:comment "The material property the campaign computes — the hierarchy entry the plan is generated FROM." ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range base:Property .

ext:hasTask a owl:ObjectProperty ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range ext:CalculationTask .

ext:pcrystal a ext:CRYSTAL ;
    rdfs:comment "The [engine.pcrystal] yascheduler engine: Pcrystal MPI binary, CRYSTAL23." ;
    owl:disjointWith ext:inpgen,
        ext:qwen ;
    ext:hasYaschedulerKey "pcrystal"^^xsd:string .

ext:prdApproved a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The reharness PRD gate: the human approves the intent (PRD), never the FSM graph. Asserted true only after the human approved the PRD." ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range xsd:boolean .

ext:wc_crystal_seebeck a ext:WorkChainStep ;
    rdfs:comment "crystal.mpds_seebeck." .

ext:wc_fleur_dos a ext:WorkChainStep ;
    rdfs:comment "fleur.dos_seebeck: DOS + Seebeck from a converged SCF." .

ext:wc_fleur_eos a ext:EOSStage,
        ext:WorkChainStep ;
    rdfs:comment "fleur.eos: volume scan of the relaxed cell; equation of state and bulk modulus from the E(V) fit." .

ext:wc_fleur_forces a ext:ForceStage,
        ext:WorkChainStep ;
    rdfs:comment "fleur.forces: single-point forces and stress tensor on the converged density of the relaxed geometry." .

ext:wc_fleur_mae a ext:MAEStage,
        ext:WorkChainStep ;
    rdfs:comment "fleur.mae: MAE magnetization-rotation scan with spin-orbit coupling; consumes the converged SCF wavefunction." .

ext:wc_fleur_mae_conv a ext:MAEStage,
        ext:WorkChainStep ;
    rdfs:comment "fleur.mae_conv: convergence check of the MAE rotation scan; the anisotropy is reported only after it passes." .

ext:wc_phonon a ext:WorkChainStep ;
    rdfs:comment "Phonon stage: FLEUR phonon workflow / CRYSTAL FREQCALC (+PREOPTGEOM INSIDE the FREQCALC block, never a sibling keyword)." .

ext:wc_phonopy_fleur a ext:PhononStage,
        ext:WorkChainStep ;
    rdfs:comment "phonopy.fleur: finite-displacement phonon frequencies via phonopy on the FLEUR engine; requires the fully relaxed geometry." .

ext:wf_crystal_phonon a ext:PhononWorkflow ;
    rdfs:comment "CRYSTAL FREQCALC with PREOPTGEOM inside the block." ;
    ext:hasStep ext:wc_crystal_scf,
        ext:wc_phonon .

ext:wf_fleur_eos a ext:EOSWorkflow ;
    rdfs:comment "FLEUR route: fleur.mpds SCF + geometry optimization, then the EOS volume scan." ;
    ext:hasStep ext:wc_fleur_eos,
        ext:wc_fleur_scf .

ext:wf_fleur_forces a ext:ForceWorkflow ;
    rdfs:comment "FLEUR route: fleur.mpds SCF + relaxation, then the force/stress evaluation." ;
    ext:hasStep ext:wc_fleur_forces,
        ext:wc_fleur_scf .

ext:wf_fleur_mae a ext:MAEWorkflow ;
    rdfs:comment "FLEUR route: fleur.mpds SCF + relaxation, then the MAE rotation scan, then the MAE convergence gate." ;
    ext:hasStep ext:wc_fleur_mae,
        ext:wc_fleur_mae_conv,
        ext:wc_fleur_scf .

ext:wf_fleur_phonon a ext:PhononWorkflow ;
    rdfs:comment "FLEUR/phonopy route: converged SCF + fully relaxed geometry, then phonopy finite displacements; complements the existing CRYSTAL FREQCALC route." ;
    ext:hasStep ext:wc_fleur_scf,
        ext:wc_phonopy_fleur .

