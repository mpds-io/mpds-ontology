            owl:onProperty base:hasSample ;
            owl:someValuesFrom base:Sample ] .

base:Pm a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Po a base:ChemicalElement,
        owl:NamedIndividual .

base:Pr a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Pt a base:ChemicalElement,
        owl:NamedIndividual .

base:Pu a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Ra a base:ChemicalElement,
        owl:NamedIndividual .

base:Rb a base:ChemicalElement,
        owl:NamedIndividual,
        ext:LargeMTSphereElement .

base:Re a base:ChemicalElement,
        owl:NamedIndividual .

base:Rf a base:ChemicalElement,
        owl:NamedIndividual .

base:Rg a base:ChemicalElement,
        owl:NamedIndividual .

base:Rh a base:ChemicalElement,
        owl:NamedIndividual .

base:Rn a base:ChemicalElement,
        owl:NamedIndividual .

base:Ru a base:ChemicalElement,
        owl:NamedIndividual .

base:S a base:ChemicalElement,
        owl:NamedIndividual .

base:Sb a base:ChemicalElement,
        owl:NamedIndividual .

base:Sc a base:ChemicalElement,
        owl:NamedIndividual .

base:Se a base:ChemicalElement,
        owl:NamedIndividual .

base:Sg a base:ChemicalElement,
        owl:NamedIndividual .

base:Si a base:ChemicalElement,
        owl:NamedIndividual .

base:Sm a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Sn a base:ChemicalElement,
        owl:NamedIndividual .

base:Sr a base:ChemicalElement,
        owl:NamedIndividual .

base:Ta a base:ChemicalElement,
        owl:NamedIndividual .

base:Tb a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Tc a base:ChemicalElement,
        owl:NamedIndividual .

base:Te a base:ChemicalElement,
        owl:NamedIndividual .

base:Th a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Ti a base:ChemicalElement,
        owl:NamedIndividual .

base:Tl a base:ChemicalElement,
        owl:NamedIndividual .

base:Tm a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Ts a base:ChemicalElement,
        owl:NamedIndividual .

base:U a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:V a base:ChemicalElement,
        owl:NamedIndividual .

base:W a base:ChemicalElement,
        owl:NamedIndividual .

base:Xe a base:ChemicalElement,
        owl:NamedIndividual .

base:Y a base:ChemicalElement,
        owl:NamedIndividual .

base:Yb a base:ChemicalElement,
        owl:NamedIndividual,
        ext:HeavyElement .

base:Zn a base:ChemicalElement,
        owl:NamedIndividual .

base:Zr a base:ChemicalElement,
        owl:NamedIndividual .

base:hasChemicalFormula a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:Material ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:StartingMaterial ;
                            rdf:rest () ] ] ] ;
    rdfs:range xsd:string .

base:hasName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:Condition ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Property ;
                            rdf:rest () ] ] ] ;
    rdfs:range xsd:string .

base:hasReference a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:CrystalStructure ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:PhaseDiagram ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:PhysicalProperty ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first base:Shape ;
                                            rdf:rest () ] ] ] ] ] ;
    rdfs:range base:Reference .

ext:ConvergenceFailureMode a owl:Class ;
    rdfs:comment "SCF/geometry convergence." ;
    rdfs:subClassOf ext:PhysicsFailureMode ;
    owl:disjointWith ext:BasisSetFailureMode,
        ext:InputPrepFailureMode .

ext:DirectYaschedulerAPI a owl:Class ;
    rdfs:comment "queue_submit_task bypassing AiiDA. No provenance; used for resubmits and tests." ;
    rdfs:subClassOf ext:SubmitChannel .

ext:MAEStage a owl:Class ;
    rdfs:comment "Magnetic-anisotropy stage: magnetization-rotation scan with spin-orbit coupling on the converged density." ;
    rdfs:subClassOf ext:WorkChainStep .

ext:PhononWorkflow a owl:Class ;
    rdfs:comment "Phonon spectrum; imaginary modes route back to geometry optimization (pitfalls 25/27)." ;
    rdfs:subClassOf ext:ComputationalWorkflow .

ext:Platform a owl:Class ;
    rdfs:comment "OS platform of a compute node." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:ReasoningLayer a owl:Class ;
    rdfs:comment "pyfactxx ontology classification: plan validation at compile time, diagnosis at runtime. Zero tokens." ;
    rdfs:subClassOf ext:FsmLayer .

ext:SCFStage a owl:Class ;
    rdfs:comment "Converged-SCF stage (fleur.mpds or crystal.mpds). Precondition step: every property workflow reading a converged charge density must start from one of these (pitfalls 30, 22)." ;
    rdfs:subClassOf ext:WorkChainStep .

ext:SeebeckWorkflow a owl:Class ;
    rdfs:comment "Seebeck coefficient: SCF convergence then DOS/Seebeck stage." ;
    rdfs:subClassOf ext:ComputationalWorkflow .

ext:VultrBareMetalNode a owl:Class ;
    rdfs:comment "vbm-24c-256gb-amd EPYC bare-metal (policy: max 1BM+1VM)." ;
    rdfs:subClassOf ext:ComputeNode ;
    owl:disjointWith ext:HetznerNode,
        ext:MacNode .

ext:exit_3xx a ext:AiiDAExitCodeFamily ;
    rdfs:comment "Other FLEUR workchain exits: 300/301 fleur.base general, 360 elastic stage." ;
    owl:disjointWith ext:exit_362,
        ext:exit_412,
        ext:exit_497,
        ext:exit_5xx .

ext:hasElement a owl:ObjectProperty ;
    rdfs:comment "Elements in the system. Range = the base ChemicalElement class. NOTE: deliberately NOT rdfs:subPropertyOf hasChemicalElements — km (Kobayashi-MaRust) has no subPropertyOf mapping; the range declaration carries the semantics." ;
    rdfs:domain ext:DFTSystem ;
    rdfs:range base:ChemicalElement .

ext:hasMitigationJUDFTWarnOnly a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "JUDFT_WARN_ONLY staged before the engine run (pitfalls 8c/32: heavy elements abort with \"Too low eigenvalue detected\" without it). AiiDA stages it automatically; direct API must put touch JUDFT_WARN_ONLY in the spawn command." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range xsd:boolean .

ext:hasMixingScheme a owl:ObjectProperty ;
    rdfs:comment "SCF mixing scheme of the task." ;
    rdfs:domain ext:CalculationTask ;
    rdfs:range ext:MixingScheme .

ext:hasSystem a owl:ObjectProperty ;
    rdfs:domain ext:CampaignPlan ;
    rdfs:range ext:DFTSystem .

ext:inpgen a ext:Inpgen ;
    rdfs:comment "inpgen input generator (lattice -> inp.xml)." ;
    owl:disjointWith ext:qwen .

ext:wc_crystal_scf a ext:SCFStage,
        ext:WorkChainStep ;
    rdfs:comment "crystal.mpds SCF (Pcrystal)." .

base:Measurement a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasProperty ;
            owl:someValuesFrom base:Property ],
        [ a owl:Restriction ;
            owl:onProperty base:hasDataType ;
            owl:someValuesFrom base:DataType ] .

base:RectangularPlot a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasCompStart ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty base:hasCompEnd ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty base:hasCompRange ],
        base:PhaseDiagram .

ext:Broyden1 a ext:MixingScheme ;
    rdfs:comment "NOT implemented in the FLEUR 6.2 build on the compute nodes (pitfall 15)." ;
    owl:disjointWith ext:Broyden2 .

ext:ExecutionMode a owl:Class ;
    rdfs:comment "How the campaign driver schedules systems." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:FsmLayer a owl:Class ;
    rdfs:comment "The aiida-reharness time-scale split: which layer owns a decision." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:HetznerNode a owl:Class ;
    rdfs:comment "VPS with intermittent SSH drops: premature DONE, truncated out.xml." ;
    rdfs:subClassOf ext:ComputeNode .

ext:LLMEngine a owl:Class ;
    rdfs:comment "A self-hosted LLM used as a zero-external-cost reasoning assistant for ontology tasks (axiom help, unmatched-failure diagnosis). Not a DFT engine." ;
    rdfs:subClassOf ext:Engine .

ext:MacNode a owl:Class ;
    rdfs:comment "Afghani-578.local arm64. Wi-Fi only, sleeps without caffeinate, DHCP address." ;
    rdfs:subClassOf ext:ComputeNode ;
    owl:disjointWith ext:HetznerNode .

ext:SubmitChannel a owl:Class ;
    rdfs:comment "How a task reaches the engine: AiiDA workchain (provenance-tracked) or direct yascheduler API." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:approvalState a ext:FsmStateKind ;
    rdfs:comment "Human approval gate: risky or policy-gated actions." ;
    owl:disjointWith ext:waitState .

ext:qwen a ext:LLMEngine ;
    rdfs:comment "The Mac's self-hosted LM Studio LLM (afghani-578.local, OpenAI-compatible API). Assistance with ontology: axiom authoring help, diagnosis of failures that match no experience signature. Zero external API cost." ;
    ext:hasEndpoint "http://afghani-578.local:1234/v1"^^xsd:string ;
    ext:hasModelId "qwen/qwen3.8-27b"^^xsd:string .

ext:waitState a ext:FsmStateKind ;
    rdfs:comment "Poll an external signal: daemon process, yascheduler DB, output file." .

base:Sample a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasMaterial ;
            owl:someValuesFrom base:Material ] .

base:StartingMaterial a owl:Class .

base:hasChemicalElements a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:Material ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:PhaseDiagram ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:Shape ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:range base:ChemicalElement .

base:hasEntry a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:CrystalStructure ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Material ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:PhaseDiagram ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first base:Reference ;
                                            rdf:rest () ] ] ] ] ] ;
    rdfs:range xsd:string .

ext:BasisSetFailureMode a owl:Class ;
    rdfs:comment "Basis-set problems: non-neutral cell, linear dependence, neighbor-list limits." ;
    rdfs:subClassOf ext:PhysicsFailureMode ;
    owl:disjointWith ext:InputPrepFailureMode .

ext:Broyden2 a ext:MixingScheme ;
    rdfs:comment "NOT implemented in the FLEUR 6.2 build (pitfall 15)." .

ext:InputPrepFailureMode a owl:Class ;
    rdfs:comment "Input-generation errors: XIncludes, latsys, primitive-vs-conventional cell." ;
    rdfs:subClassOf ext:PhysicsFailureMode .

ext:exit_303 a ext:AiiDAExitCodeFamily ;
    rdfs:comment "SCF did not converge OR retrieved folder lacks out.xml (pitfall 39: check for SSH-drop DONE-marking)." ;
    owl:disjointWith ext:exit_362,
        ext:exit_3xx,
        ext:exit_412,
        ext:exit_497,
        ext:exit_5xx .

ext:exit_362 a ext:AiiDAExitCodeFamily ;
    rdfs:comment "ERROR_DID_NOT_CONVERGE: SCF ran full iterations without converging. Physics, not infra." ;
    owl:disjointWith ext:exit_412,
        ext:exit_497,
        ext:exit_5xx .

base:Condition a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasName ;
            owl:someValuesFrom xsd:string ] .

base:DataType a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first [ a owl:Class ;
                            owl:oneOf [ a rdf:List ;
                                    rdf:first base:AbInitio ;
                                    rdf:rest () ] ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ a owl:Class ;
                                    owl:oneOf [ a rdf:List ;
                                            rdf:first base:MachineLearning ;
                                            rdf:rest () ] ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ a owl:Class ;
                                            owl:oneOf [ a rdf:List ;
                                                    rdf:first base:PeerReviewed ;
                                                    rdf:rest () ] ] ;
                                    rdf:rest () ] ] ] ] .

base:Reference a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasEntry ;
            owl:someValuesFrom xsd:string ] .

ext:ComputeNode a owl:Class ;
    rdfs:comment "A machine registered in yascheduler_nodes." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:FsmStateKind a owl:Class ;
    rdfs:comment "reharness FSM state kinds: where a fix routes. Decisions belong to FSM states, never to imperative runtime glue." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:LargeMTSphereElement a owl:Class ;
    rdfs:comment "Cations with inpgen-auto large MT spheres (2.7-2.8 bohr): high-n s valence states cannot confine; differ 2 at setup (pitfall 37)." .

ext:MixingScheme a owl:Class ;
    rdfs:comment "FLEUR SCF charge-density mixing (InputSchema 0.37)." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:agentState a ext:FsmStateKind ;
    rdfs:comment "LLM judgment leaf: novel diagnosis, input authoring." ;
    owl:disjointWith ext:approvalState,
        ext:waitState .

ext:wc_fleur_scf a ext:SCFStage,
        ext:WorkChainStep ;
    rdfs:comment "fleur.mpds SCF + geometry optimization (the campaign workhorse)." .

ext:DFTSystem a owl:Class ;
    rdfs:comment "A concrete material system submitted to an ab-initio campaign. The unit of serial one-system-at-a-time campaigns." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:Engine a owl:Class ;
    rdfs:comment "An ab-initio code." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:exit_412 a ext:AiiDAExitCodeFamily ;
    rdfs:comment "fleur.mpds top-level: SCF converged but downstream property calc not triggered." ;
    owl:disjointWith ext:exit_497,
        ext:exit_5xx .

ext:exit_497 a ext:AiiDAExitCodeFamily ;
    rdfs:comment "CDGFleurSCFOptimizer: SCF converged but lattice optimization incomplete." ;
    owl:disjointWith ext:exit_5xx .

ext:exit_5xx a ext:AiiDAExitCodeFamily ;
    rdfs:comment "Infra failures, empty reason string in the dft.mpds.io listing." .

base:Preparation a owl:Class .

ext:ComputationalWorkflow a owl:Class ;
    rdfs:comment "A workflow (workchain composition) computing material properties. The subject of on-the-fly generation: the plan names a property; the ontology supplies the workflow that realizes it." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:InfraFailureMode a owl:Class ;
    rdfs:comment "Infrastructure failures: SSH drops, zombie processes, occupancy-poll bugs, spawn-channel hangup. Fix infrastructure; NEVER answer with SCF parameter tuning." ;
    rdfs:subClassOf ext:EngineFailureMode ;
    owl:disjointWith ext:PhysicsFailureMode .

base:DiaType a owl:Class ;
    rdfs:comment "Phase diagram type (mostly actual for the *arity* > 2, i.e. ternaries, quaternaries etc.)" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first [ a owl:Class ;
                            owl:oneOf [ a rdf:List ;
                                    rdf:first base:Binary ;
                                    rdf:rest () ] ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ a owl:Class ;
                                    owl:oneOf [ a rdf:List ;
                                            rdf:first base:IsothermalSection ;
                                            rdf:rest () ] ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ a owl:Class ;
                                            owl:oneOf [ a rdf:List ;
                                                    rdf:first base:LiquidusProjection ;
                                                    rdf:rest () ] ] ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first [ a owl:Class ;
                                                    owl:oneOf [ a rdf:List ;
                                                            rdf:first base:SolidusProjection ;
                                                            rdf:rest () ] ] ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first [ a owl:Class ;
                                                            owl:oneOf [ a rdf:List ;
                                                                    rdf:first base:SolvusProjection ;
                                                                    rdf:rest () ] ] ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first [ a owl:Class ;
                                                                    owl:oneOf [ a rdf:List ;
                                                                            rdf:first base:SubsolidusRelations ;
                                                                            rdf:rest () ] ] ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first [ a owl:Class ;
                                                                            owl:oneOf [ a rdf:List ;
                                                                                    rdf:first base:VerticalSection ;
                                                                                    rdf:rest () ] ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] .

base:Material a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasChemicalElements ;
            owl:someValuesFrom base:ChemicalElement ],
        [ a owl:Restriction ;
            owl:onProperty base:hasChemicalFormula ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasConditions ;
            owl:someValuesFrom base:Condition ],
        [ a owl:Restriction ;
            owl:onProperty base:hasEntry ;
            owl:someValuesFrom xsd:string ] .

base:TriangularPlot a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasCompB ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty base:hasTitleC ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasTitleA ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty base:hasRangeC ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty base:hasRangeB ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty base:hasRangeA ],
        [ a owl:Restriction ;
            owl:onProperty base:hasTitleB ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasCompA ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty base:hasCompC ;
            owl:someValuesFrom owl:Thing ],
        base:PhaseDiagram .

ext:AiiDAExitCodeFamily a owl:Class ;
    rdfs:comment "Exit-code family of a finished process (dft.mpds.io listing convention)." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:codeState a ext:FsmStateKind ;
    rdfs:comment "Deterministic code leaf: run the fix command, no tokens." ;
    owl:disjointWith ext:agentState,
        ext:approvalState,
        ext:waitState .

ext:EngineFailureMode a owl:Class ;
    rdfs:comment "A class of engine failures with known detection, cause and fix." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:PhysicsFailureMode a owl:Class ;
    rdfs:comment "Physics-level failures: convergence, ghost states, MT-sphere confinement, basis set." ;
    rdfs:subClassOf ext:EngineFailureMode .

base:PhaseDiagram a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass base:ChemicalElement ;
            owl:onProperty base:hasChemicalElements ],
        [ a owl:Restriction ;
            owl:onProperty base:hasShapes ;
            owl:someValuesFrom base:Shape ],
        [ a owl:Restriction ;
            owl:onProperty base:hasReference ;
            owl:someValuesFrom base:Reference ],
        [ a owl:Restriction ;
            owl:onProperty base:hasDiaType ;
            owl:someValuesFrom base:DiaType ],
        [ a owl:Restriction ;
            owl:onProperty base:hasNaxes ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 2 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 3 ] ;
                                    rdf:rest () ] ] ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
            owl:onClass base:ChemicalElement ;
            owl:onProperty base:hasChemicalElements ],
        [ a owl:Restriction ;
            owl:onProperty base:hasEntry ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasArity ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 2 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 8 ] ;
                                    rdf:rest () ] ] ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:onDatatype xsd:double ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive -5e+02 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 6e+03 ] ;
                                    rdf:rest () ] ] ] ;
            owl:onProperty base:hasTemp ] .

ext:CampaignPlan a owl:Class ;
    rdfs:comment "A compiled aiida-reharness campaign: systems, tasks, execution rules. The subject of the PRD gate." ;
    rdfs:subClassOf ext:ComputationalArtefact .

base:Property a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasDomain ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasCategory ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasUnits ;
            owl:someValuesFrom xsd:string ] .

base:Shape a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
            owl:onClass base:ChemicalElement ;
            owl:onProperty base:hasChemicalElements ],
        [ a owl:Restriction ;
            owl:onProperty base:hasSvgPath ;
            owl:someValuesFrom xsd:string ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first base:Compound ;
                    rdf:rest [ a rdf:List ;
                            rdf:first base:Drawing ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first base:Phase ;
                                    rdf:rest () ] ] ] ] .

ext:ComputationalArtefact a owl:Class ;
    rdfs:comment "Root of the aiida-reharness computation layer. Additive over the base materials ontology." .

ext:WorkChainStep a owl:Class ;
    rdfs:comment "One AiiDA workchain in a workflow composition." ;
    rdfs:subClassOf ext:ComputationalArtefact .

base:CrystalStructure a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base:hasVolume ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:double ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 0e+00 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 6e+05 ] ;
                                    rdf:rest () ] ] ] ],
        [ a owl:Restriction ;
            owl:onProperty base:hasChemicalFormula ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasSgN ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 1 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 230 ] ;
                                    rdf:rest () ] ] ] ],
        [ a owl:Restriction ;
            owl:onProperty base:hasSgHm ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasSymOps ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasPrototype ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty base:hasDensity ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:double ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 0e+00 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 5e+01 ] ;
                                    rdf:rest () ] ] ] ],
        [ a owl:Restriction ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:onDatatype xsd:double ;
                    owl:withRestrictions [ a rdf:List ;
                            rdf:first [ xsd:minInclusive 5e-01 ] ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first [ xsd:maxInclusive 1.305e+03 ] ;
                                    rdf:rest () ] ] ] ;
            owl:onProperty base:hasCellAbcs ;
            owl:qualifiedCardinality "6"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty base:hasReference ;
            owl:someValuesFrom base:Reference ],
        [ a owl:Restriction ;
            owl:onProperty base:hasEntry ;
            owl:someValuesFrom xsd:string ] .

ext:CalculationTask a owl:Class ;
    rdfs:comment "One engine run (SCF, geometry optimization, phonons). Maps to an AiiDA CalcJob or a direct yascheduler task." ;
    rdfs:subClassOf ext:ComputationalArtefact .

ext:HeavyElement a owl:Class ;
    rdfs:comment "f-electron elements: lanthanides + actinides. Ghost states (JUDFT_WARN_ONLY), 4f occupation fluctuation is normal (pitfalls 8c, 9)." .

